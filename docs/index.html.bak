<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="NI6 Neutral Intelligence Service 6. Algorithmic Consistency. Verifiable Neutrality.">
    <title>NI6 Neutral Intelligence Service 6</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <!-- AOS Library -->
    <link href="https://unpkg.com/aos@next/dist/aos.css" rel="stylesheet">

    <!-- Highlight.js -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github-dark.min.css">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="css/styles.css">
</head>
<body>
    <!-- Navigation -->
    <nav class="nav" data-aos="fade-down">
        <div class="container nav-container">
            <div class="logo">NI6</div>
            <div class="nav-links">
                <a href="#philosophy">Philosophy</a>
                <a href="#flow">Registration Flow</a>
                <a href="#architecture">Architecture</a>
                <a href="#technology">Technology</a>
                <a href="#quickstart">Quick Start</a>
                <a href="https://github.com/your-org/ni6" class="btn-github">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
                    </svg>
                    GitHub
                </a>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero">
        <div class="container hero-container">
            <div class="hero-content" data-aos="fade-down" data-aos-duration="1000">
                <div class="hero-badge">
                    <span class="pulse"></span>
                    Open Source Identity Verification
                </div>
                <h1 class="hero-title">
                    <span class="gradient-text">NI6</span>
                    <span class="hero-subtitle">Neutral Intelligence Service 6</span>
                </h1>
                <p class="hero-tagline" id="typewriter"></p>
                <p class="hero-description">
                    Algorithmic KYC that performs verification without exposing personal information to humans.
                    Secure hand gesture based secret share storage and recovery eliminates third parties completely.
                </p>
                <div class="hero-actions">
                    <a href="#quickstart" class="btn btn-primary">Get Started</a>
                    <a href="https://github.com/your-org/ni6" class="btn btn-secondary">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
                        </svg>
                        View on GitHub
                    </a>
                </div>
            </div>
            <div class="hero-visual" data-aos="fade-up" data-aos-duration="1200" data-aos-delay="200">
                <div class="floating-card">
                    <div class="card-header">
                        <div class="card-dots">
                            <span></span><span></span><span></span>
                        </div>
                        <span class="card-title">Verification Result</span>
                    </div>
                    <div class="card-body">
                        <div class="metric">
                            <span class="metric-label">Face Match</span>
                            <span class="metric-value success">92.3%</span>
                        </div>
                        <div class="metric">
                            <span class="metric-label">Authenticity</span>
                            <span class="metric-value success">85.7%</span>
                        </div>
                        <div class="metric">
                            <span class="metric-label">Risk Score</span>
                            <span class="metric-value neutral">15/100</span>
                        </div>
                        <div class="metric">
                            <span class="metric-label">Decision</span>
                            <span class="metric-badge success">APPROVED</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="hero-bg">
            <div class="grid"></div>
        </div>
    </section>

    <!-- Value Proposition -->
    <section class="value-prop">
        <div class="container">
            <div class="section-header" data-aos="fade-up">
                <h2>Why NI6?</h2>
                <p>Decentralized custody meets algorithmic neutrality</p>
            </div>
            <div class="cards-grid">
                <div class="card" data-aos="fade-up" data-aos-delay="100">
                    <div class="card-icon">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                            <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
                        </svg>
                    </div>
                    <h3>Decentralized Custody</h3>
                    <p>Shamir Secret Sharing (2 of 3 threshold) eliminates single points of failure. No trusted third party required.</p>
                </div>
                <div class="card" data-aos="fade-up" data-aos-delay="200">
                    <div class="card-icon">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                            <circle cx="12" cy="12" r="10"/>
                            <path d="M12 16v-4M12 8h.01"/>
                        </svg>
                    </div>
                    <h3>Algorithmic Neutrality</h3>
                    <p>Deterministic algorithms apply identical criteria to every applicant. Full audit trails for compliance.</p>
                </div>
                <div class="card" data-aos="fade-up" data-aos-delay="300">
                    <div class="card-icon">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                            <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                        </svg>
                    </div>
                    <h3>Zero API Costs</h3>
                    <p>Self-contained OSINT with locally maintained databases. No per-query fees for sanctions, PEP, or negative news.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Problem Section -->
    <section class="problem" id="philosophy">
        <div class="container">
            <div class="section-header" data-aos="fade-up">
                <h2>Your Data and Assets Travel Far Beyond Who You Trust</h2>
                <p>KYC providers and custodians create invisible security risks for both your personal information and your digital assets</p>
            </div>

            <!-- Data Flow Visualization -->
            <div class="data-flow-warning" data-aos="fade-up" data-aos-delay="100">
                <div class="warning-header">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                        <line x1="12" y1="9" x2="12" y2="13"/>
                        <line x1="12" y1="17" x2="12.01" y2="17"/>
                    </svg>
                    <h3>The Invisible Chain of Trust</h3>
                </div>
                <div class="flow-chain">
                    <div class="chain-step">
                        <span class="chain-icon">👤</span>
                        <span class="chain-text">You</span>
                    </div>
                    <div class="chain-arrow">→</div>
                    <div class="chain-step primary">
                        <span class="chain-icon">🏢</span>
                        <span class="chain-text">Platform You Trust</span>
                    </div>
                    <div class="chain-arrow">→</div>
                    <div class="chain-step danger">
                        <span class="chain-icon">🔓</span>
                        <span class="chain-text">KYC Provider + Custodian</span>
                    </div>
                    <div class="chain-arrow">→</div>
                    <div class="chain-step danger">
                        <span class="chain-icon">💾</span>
                        <span class="chain-text">Their Sub-processors</span>
                    </div>
                </div>
                <p class="warning-text">Your passport, selfie, ID card, personal details, AND private keys controlling your digital assets are stored on servers you have never heard of, governed by policies you have never seen.</p>
            </div>

            <!-- Problem Items -->
            <div class="problem-list">
                <div class="problem-item danger" data-aos="fade-right">
                    <div class="problem-icon">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                            <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                            <line x1="12" y1="22.08" x2="12" y2="12"/>
                        </svg>
                    </div>
                    <div class="problem-content">
                        <h3>KYC Providers Have Your Full PII</h3>
                        <p>When you verify on any platform, your documents go to Jumio, Onfido, Stripe Identity, or similar providers. They store your passport scans, selfies, and extracted personal data. One breach at <strong>their</strong> end compromises <strong>your</strong> identity forever. Your private information is no longer private.</p>
                    </div>
                </div>

                <div class="problem-item danger" data-aos="fade-left">
                    <div class="problem-icon">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/>
                            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
                        </svg>
                    </div>
                    <div class="problem-content">
                        <h3>Custodians Control Your Digital Assets</h3>
                        <p>Nearly every exchange uses custodians like Fireblocks, Coinbase Custody, or BitGo. You do not own your assets, the custodian does. When policies get misconfigured or the custodian is compromised, your digital assets disappear. Not your keys, not your coins.</p>
                    </div>
                </div>

                <div class="problem-item hack" data-aos="fade-right">
                    <div class="problem-icon">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
                        </svg>
                    </div>
                    <div class="problem-content">
                        <h3>ByBit Custodian Hack (October 2024)</h3>
                        <p>Fireblocks enabled custodian lost $1.5B+ in crypto. The attack exploited a misconfigured policy between the platform and custodian, not a direct breach of ByBit. Users who thought they had secure custody found their funds gone due to third party configuration error.</p>
                    </div>
                </div>

                <div class="problem-item hack" data-aos="fade-left">
                    <div class="problem-icon">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                            <path d="M8 11h8M8 15h8"/>
                        </svg>
                    </div>
                    <div class="problem-content">
                        <h3>WazirX Collapse (July 2024)</h3>
                        <p>$230M+ lost after a custodial wallet breach. WazirX used Liminal Custody, yet another third party in the chain. The attack exploited multisig wallet configuration vulnerabilities. Users funds were stolen through no fault of their own.</p>
                    </div>
                </div>

                <div class="problem-item" data-aos="fade-right">
                    <div class="problem-icon">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/>
                            <line x1="12" y1="8" x2="12" y2="16"/>
                            <line x1="8" y1="12" x2="16" y2="12"/>
                        </svg>
                    </div>
                    <div class="problem-content">
                        <h3>The Sub-Processing Chain Never Ends</h3>
                        <p>KYC providers and custodians themselves use cloud services (AWS, GCP), ML APIs, support contractors, and data analytics firms. Your personal information and private keys propagate through an expanding attack surface. Every link is a potential breach point for both your identity and your digital assets.</p>
                    </div>
                </div>
            </div>

            <!-- The NI6 Difference -->
            <div class="ni6-difference" data-aos="fade-up" data-aos-delay="300">
                <h3>The NI6 Approach: Zero Third Party Exposure to Your Data or Assets</h3>
                <div class="difference-grid">
                    <div class="difference-item">
                        <div class="diff-icon success">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                        </div>
                        <div class="diff-content">
                            <h4>PII Stays on Your Device</h4>
                            <p>Extracted data is encrypted to <strong>your</strong> public key. KYC providers never see it.</p>
                        </div>
                    </div>
                    <div class="difference-item">
                        <div class="diff-icon success">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                        </div>
                        <div class="diff-content">
                            <h4>You Own Your Digital Assets</h4>
                            <p>Your private keys are distributed using Shamir sharing. No custodian can freeze or seize your assets. Not your keys, not your coins becomes a reality with NI6.</p>
                        </div>
                    </div>
                    <div class="difference-item">
                        <div class="diff-icon success">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                        </div>
                        <div class="diff-content">
                            <h4>Gesture Based Recovery</h4>
                            <p>Recover your shares using video selfie with hand gestures. No SMS, no custodians, no social recovery guardians needed.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Registration Flow Section -->
    <section class="registration-flow" id="flow">
        <div class="container">
            <div class="section-header" data-aos="fade-up">
                <h2>Registration Flow</h2>
                <p>How client apps interact with NI6, PII stays encrypted, algorithms decide</p>
            </div>
            <div class="flow-diagram" data-aos="zoom-in" data-aos-duration="1000">
                <svg viewBox="0 0 900 500" class="flow-svg">
                    <!-- Background -->
                    <rect width="900" height="500" fill="#0a0a0f"/>

                    <!-- Grid pattern -->
                    <defs>
                        <pattern id="flowGrid" width="20" height="20" patternUnits="userSpaceOnUse">
                            <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#1a1a2e" stroke-width="0.5"/>
                        </pattern>
                        <linearGradient id="greenGradient" x1="0%" y1="0%" x2="100%" y2="0%">
                            <stop offset="0%" style="stop-color:#00d4aa;stop-opacity:0.2"/>
                            <stop offset="100%" style="stop-color:#00d4aa;stop-opacity:0.05"/>
                        </linearGradient>
                    </defs>
                    <rect width="900" height="500" fill="url(#flowGrid)"/>

                    <!-- Title -->
                    <text x="450" y="35" text-anchor="middle" fill="#ffffff" font-family="Inter" font-size="16" font-weight="600">Client Side Registration: Privacy by Design</text>

                    <!-- Client App Box -->
                    <g class="flow-box client-app" transform="translate(50, 60)">
                        <rect width="140" height="380" rx="12" fill="#1a1a2e" stroke="#00d4aa" stroke-width="2"/>
                        <text x="70" y="30" text-anchor="middle" fill="#00d4aa" font-family="Inter" font-size="14" font-weight="600">Client App</text>
                        <text x="70" y="50" text-anchor="middle" fill="#888888" font-family="Inter" font-size="11">(User's Device)</text>

                        <!-- Client: Generate Keys -->
                        <g transform="translate(15, 80)">
                            <rect width="110" height="50" rx="6" fill="#00d4aa" opacity="0.15"/>
                            <text x="55" y="20" text-anchor="middle" fill="#00d4aa" font-family="Inter" font-size="10" font-weight="600">1. Generate</text>
                            <text x="55" y="35" text-anchor="middle" fill="#00d4aa" font-family="Inter" font-size="9">SECP256k1 KeyPair</text>
                        </g>

                        <!-- Client: Capture Documents -->
                        <g transform="translate(15, 150)">
                            <rect width="110" height="50" rx="6" fill="#00d4aa" opacity="0.15"/>
                            <text x="55" y="20" text-anchor="middle" fill="#00d4aa" font-family="Inter" font-size="10" font-weight="600">3. Capture</text>
                            <text x="55" y="35" text-anchor="middle" fill="#00d4aa" font-family="Inter" font-size="9">Document + Selfie</text>
                        </g>

                        <!-- Client: Receive Encrypted Data -->
                        <g transform="translate(15, 270)">
                            <rect width="110" height="80" rx="6" fill="#00d4aa" opacity="0.2"/>
                            <text x="55" y="20" text-anchor="middle" fill="#00d4aa" font-family="Inter" font-size="10" font-weight="600">7. Receive</text>
                            <text x="55" y="35" text-anchor="middle" fill="#00d4aa" font-family="Inter" font-size="9">ENCRYPTED</text>
                            <text x="55" y="50" text-anchor="middle" fill="#00d4aa" font-family="Inter" font-size="9">Extracted Data</text>
                            <text x="55" y="68" text-anchor="middle" fill="#6366f1" font-family="Inter" font-size="8">(Only user can decrypt)</text>
                        </g>
                    </g>

                    <!-- NI6 Server Box -->
                    <g class="flow-box server" transform="translate(380, 60)">
                        <rect width="200" height="380" rx="12" fill="#1a1a2e" stroke="#6366f1" stroke-width="2"/>
                        <text x="100" y="30" text-anchor="middle" fill="#6366f1" font-family="Inter" font-size="14" font-weight="600">NI6 Servers</text>
                        <text x="100" y="50" text-anchor="middle" fill="#888888" font-family="Inter" font-size="11">(Algorithmic Processing)</text>

                        <!-- NI6: OTP Request -->
                        <g transform="translate(15, 80)">
                            <rect width="170" height="50" rx="6" fill="#6366f1" opacity="0.15"/>
                            <text x="85" y="20" text-anchor="middle" fill="#6366f1" font-family="Inter" font-size="10" font-weight="600">2. Request OTP</text>
                            <text x="85" y="35" text-anchor="middle" fill="#888888" font-family="Inter" font-size="9">ECDSA signature required</text>
                        </g>

                        <!-- NI6: Process Documents -->
                        <g transform="translate(15, 150)">
                            <rect width="170" height="90" rx="6" fill="#6366f1" opacity="0.15"/>
                            <text x="85" y="20" text-anchor="middle" fill="#6366f1" font-family="Inter" font-size="10" font-weight="600">4. Process Documents</text>
                            <text x="85" y="38" text-anchor="middle" fill="#888888" font-family="Inter" font-size="8">• OCR & Extraction</text>
                            <text x="85" y="52" text-anchor="middle" fill="#888888" font-family="Inter" font-size="8">• Face Verification</text>
                            <text x="85" y="66" text-anchor="middle" fill="#888888" font-family="Inter" font-size="8">• Forgery Detection</text>
                            <text x="85" y="80" text-anchor="middle" fill="#888888" font-family="Inter" font-size="8">• OSINT Screening</text>
                        </g>

                        <!-- NI6: Return Results -->
                        <g transform="translate(15, 270)">
                            <rect width="170" height="80" rx="6" fill="#6366f1" opacity="0.15"/>
                            <text x="85" y="20" text-anchor="middle" fill="#6366f1" font-family="Inter" font-size="10" font-weight="600">6. Return Two Things:</text>
                            <text x="85" y="40" text-anchor="middle" fill="#00d4aa" font-family="Inter" font-size="9">A) KYC Decision (approve or reject)</text>
                            <text x="85" y="60" text-anchor="middle" fill="#ec4899" font-family="Inter" font-size="9">B) ENCRYPTED extracted data</text>
                            <text x="85" y="75" text-anchor="middle" fill="#888888" font-family="Inter" font-size="7">(encrypted with user's public key)</text>
                        </g>
                    </g>

                    <!-- Your Service Backend Box -->
                    <g class="flow-box business-server" transform="translate(710, 60)">
                        <rect width="140" height="380" rx="12" fill="#1a1a2e" stroke="#8b5cf6" stroke-width="2"/>
                        <text x="70" y="30" text-anchor="middle" fill="#8b5cf6" font-family="Inter" font-size="14" font-weight="600">Your Service</text>
                        <text x="70" y="50" text-anchor="middle" fill="#888888" font-family="Inter" font-size="11">(Service Backend)</text>

                        <!-- Your Service: Decision Only -->
                        <g transform="translate(15, 270)">
                            <rect width="110" height="80" rx="6" fill="#8b5cf6" opacity="0.15"/>
                            <text x="55" y="25" text-anchor="middle" fill="#8b5cf6" font-family="Inter" font-size="10" font-weight="600">5. Receives</text>
                            <text x="55" y="45" text-anchor="middle" fill="#8b5cf6" font-family="Inter" font-size="9">KYC Decision</text>
                            <text x="55" y="65" text-anchor="middle" fill="#888888" font-family="Inter" font-size="8">(NO PII!)</text>
                            <text x="55" y="78" text-anchor="middle" fill="#22c55e" font-family="Inter" font-size="8">Just: APPROVED</text>
                        </g>
                    </g>

                    <!-- Data Flow Arrows -->
                    <!-- Arrow 1: Client -> NI6 (OTP Request) -->
                    <g>
                        <path d="M 190 105 L 380 105" stroke="#00d4aa" stroke-width="2" marker-end="url(#arrowGreen)" class="flow-arrow"/>
                        <text x="285" y="95" text-anchor="middle" fill="#00d4aa" font-family="Inter" font-size="9">POST /api/otp/</text>
                    </g>

                    <!-- Arrow 2: NI6 -> Client (OTP Response) -->
                    <g>
                        <path d="M 380 120 L 190 120" stroke="#6366f1" stroke-width="2" stroke-dasharray="4,4" marker-end="url(#arrowPurple)" class="flow-arrow"/>
                        <text x="285" y="138" text-anchor="middle" fill="#6366f1" font-family="Inter" font-size="9">Encrypted OTP</text>
                    </g>

                    <!-- Arrow 3: Client -> NI6 (Submit Document) -->
                    <g>
                        <path d="M 190 175 L 380 175" stroke="#00d4aa" stroke-width="2" marker-end="url(#arrowGreen)" class="flow-arrow"/>
                        <text x="285" y="165" text-anchor="middle" fill="#00d4aa" font-family="Inter" font-size="9">POST /api/jobs/analyze-async</text>
                    </g>

                    <!-- Arrow 4: NI6 -> Your Service Backend (Decision) -->
                    <g>
                        <path d="M 580 310 L 710 310" stroke="#6366f1" stroke-width="2" marker-end="url(#arrowPurple)" class="flow-arrow"/>
                        <text x="645" y="300" text-anchor="middle" fill="#6366f1" font-family="Inter" font-size="9">KYC Result</text>
                        <text x="645" y="325" text-anchor="middle" fill="#888888" font-family="Inter" font-size="8">{decision: "APPROVED"}</text>
                    </g>

                    <!-- Arrow 5: NI6 -> Client (Encrypted Data) -->
                    <g>
                        <path d="M 380 330 L 190 330" stroke="#ec4899" stroke-width="2" stroke-dasharray="4,4" marker-end="url(#arrowPink)" class="flow-arrow"/>
                        <text x="285" y="350" text-anchor="middle" fill="#ec4899" font-family="Inter" font-size="9">ECIES Encrypted Data</text>
                        <text x="285" y="365" text-anchor="middle" fill="#888888" font-family="Inter" font-size="8">{name, dob, address...}</text>
                    </g>

                    <!-- Arrow Markers -->
                    <defs>
                        <marker id="arrowGreen" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
                            <polygon points="0 0, 10 3, 0 6" fill="#00d4aa"/>
                        </marker>
                        <marker id="arrowPurple" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
                            <polygon points="0 0, 10 3, 0 6" fill="#6366f1"/>
                        </marker>
                        <marker id="arrowPink" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
                            <polygon points="0 0, 10 3, 0 6" fill="#ec4899"/>
                        </marker>
                    </defs>

                    <!-- Privacy Notice -->
                    <g transform="translate(50, 460)">
                        <rect width="800" height="30" rx="6" fill="url(#greenGradient)" stroke="#00d4aa" stroke-width="1"/>
                        <text x="400" y="20" text-anchor="middle" fill="#00d4aa" font-family="Inter" font-size="11" font-weight="600">PRIVACY GUARANTEE: Your server NEVER sees user PII. Only the client app receives encrypted extracted data.</text>
                    </g>
                </svg>
            </div>

            <!-- Flow Steps Detail -->
            <div class="flow-steps" data-aos="fade-up" data-aos-delay="200">
                <div class="flow-step">
                    <div class="step-number">1</div>
                    <h4>Generate KeyPair</h4>
                    <p>Client app generates SECP256k1 keypair. Private key never leaves device.</p>
                </div>
                <div class="flow-step">
                    <div class="step-number">2</div>
                    <h4>Request OTP</h4>
                    <p>Client requests OTP using ECDSA signature. Response encrypted with client's public key.</p>
                </div>
                <div class="flow-step">
                    <div class="step-number">3</div>
                    <h4>Capture & Submit</h4>
                    <p>Document image, selfie/video submitted with signed request to NI6.</p>
                </div>
                <div class="flow-step">
                    <div class="step-number">4</div>
                    <h4>Algorithmic Processing</h4>
                    <p>NI6 runs OCR, face verification, forgery detection, OSINT screening, no human sees PII.</p>
                </div>
                <div class="flow-step">
                    <div class="step-number">5</div>
                    <h4>Decision to Your Service Backend</h4>
                    <p>Your service backend receives ONLY the KYC decision (APPROVED or REJECTED), zero PII.</p>
                </div>
                <div class="flow-step">
                    <div class="step-number">6</div>
                    <h4>Encrypted Data to Client</h4>
                    <p>Extracted data returned ECIES-encrypted to client. Only user can decrypt.</p>
                </div>
                <div class="flow-step">
                    <div class="step-number">7</div>
                    <h4>Client Decrypts</h4>
                    <p>Client app decrypts extracted data with private key for local use/storage.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Architecture Section -->
    <section class="architecture" id="architecture">
        <div class="container">
            <div class="section-header" data-aos="fade-up">
                <h2>Distributed Architecture</h2>
                <p>Two critical purposes: distributed secret storage AND fault tolerance</p>
            </div>

            <!-- Purpose 1: Secret Sharing -->
            <div class="architecture-purpose" data-aos="fade-up" data-aos-delay="100">
                <h3><span class="purpose-number">1</span> Distributed Secret Storage</h3>
                <p>Shamir's Secret Sharing (2 of 3 threshold) ensures no single server ever has the complete private key.</p>
            </div>

            <div class="architecture-diagram" data-aos="zoom-in" data-aos-duration="1000">
                <svg viewBox="0 0 800 400" class="arch-svg">
                    <!-- Background -->
                    <rect width="800" height="400" fill="#0a0a0f"/>

                    <!-- Grid pattern -->
                    <defs>
                        <pattern id="smallGrid" width="20" height="20" patternUnits="userSpaceOnUse">
                            <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#1a1a2e" stroke-width="0.5"/>
                        </pattern>
                    </defs>
                    <rect width="800" height="400" fill="url(#smallGrid)"/>

                    <!-- Title -->
                    <text x="400" y="30" text-anchor="middle" fill="#888888" font-family="Inter" font-size="12">PURPOSE 1: SECRET SHARING</text>

                    <!-- Client Device -->
                    <g class="node client" transform="translate(50, 150)">
                        <rect x="0" y="0" width="120" height="100" rx="8" fill="#1a1a2e" stroke="#00d4aa" stroke-width="2"/>
                        <text x="60" y="45" text-anchor="middle" fill="#ffffff" font-family="Inter" font-size="14" font-weight="600">Client</text>
                        <text x="60" y="65" text-anchor="middle" fill="#888888" font-family="Inter" font-size="11">Device</text>
                        <text x="60" y="85" text-anchor="middle" fill="#00d4aa" font-family="Inter" font-size="10">Private Key</text>
                    </g>

                    <!-- Split animation path -->
                    <path d="M 170 200 L 230 200" stroke="#00d4aa" stroke-width="2" stroke-dasharray="5,5" class="flow-line"/>

                    <!-- Split Circle -->
                    <circle cx="200" cy="200" r="25" fill="#1a1a2e" stroke="#00d4aa" stroke-width="2" class="pulse-circle"/>
                    <text x="200" y="205" text-anchor="middle" fill="#00d4aa" font-family="Inter" font-size="10">SPLIT</text>

                    <!-- Server 1 -->
                    <g class="node server" transform="translate(270, 50)">
                        <rect x="0" y="0" width="100" height="80" rx="8" fill="#1a1a2e" stroke="#6366f1" stroke-width="2"/>
                        <text x="50" y="35" text-anchor="middle" fill="#ffffff" font-family="Inter" font-size="12" font-weight="600">Server 1</text>
                        <text x="50" y="55" text-anchor="middle" fill="#6366f1" font-family="Inter" font-size="10">Share 0</text>
                    </g>

                    <!-- Server 2 -->
                    <g class="node server" transform="translate(270, 160)">
                        <rect x="0" y="0" width="100" height="80" rx="8" fill="#1a1a2e" stroke="#8b5cf6" stroke-width="2"/>
                        <text x="50" y="35" text-anchor="middle" fill="#ffffff" font-family="Inter" font-size="12" font-weight="600">Server 2</text>
                        <text x="50" y="55" text-anchor="middle" fill="#8b5cf6" font-family="Inter" font-size="10">Share 1</text>
                    </g>

                    <!-- Server 3 -->
                    <g class="node server" transform="translate(270, 270)">
                        <rect x="0" y="0" width="100" height="80" rx="8" fill="#1a1a2e" stroke="#ec4899" stroke-width="2"/>
                        <text x="50" y="35" text-anchor="middle" fill="#ffffff" font-family="Inter" font-size="12" font-weight="600">Server 3</text>
                        <text x="50" y="55" text-anchor="middle" fill="#ec4899" font-family="Inter" font-size="10">Share 2</text>
                    </g>

                    <!-- Connection lines to servers -->
                    <path d="M 225 200 L 270 90" stroke="#6366f1" stroke-width="1.5" stroke-dasharray="4,4" class="flow-line"/>
                    <path d="M 225 200 L 270 200" stroke="#8b5cf6" stroke-width="1.5" stroke-dasharray="4,4" class="flow-line"/>
                    <path d="M 225 200 L 270 310" stroke="#ec4899" stroke-width="1.5" stroke-dasharray="4,4" class="flow-line"/>

                    <!-- Any 2 label -->
                    <rect x="420" y="175" width="120" height="50" rx="25" fill="#00d4aa" opacity="0.2"/>
                    <text x="480" y="205" text-anchor="middle" fill="#00d4aa" font-family="Inter" font-size="11" font-weight="600">Any 2 shares</text>
                    <text x="480" y="220" text-anchor="middle" fill="#00d4aa" font-family="Inter" font-size="10">reconstruct secret</text>

                    <!-- Recovered Client -->
                    <g class="node client" transform="translate(580, 150)">
                        <rect x="0" y="0" width="120" height="100" rx="8" fill="#1a1a2e" stroke="#00d4aa" stroke-width="2"/>
                        <text x="60" y="45" text-anchor="middle" fill="#ffffff" font-family="Inter" font-size="14" font-weight="600">Client</text>
                        <text x="60" y="65" text-anchor="middle" fill="#888888" font-family="Inter" font-size="11">Device</text>
                        <text x="60" y="85" text-anchor="middle" fill="#00d4aa" font-family="Inter" font-size="10">Key Recovered</text>
                    </g>

                    <!-- Arrow to recovered -->
                    <path d="M 540 200 L 580 200" stroke="#00d4aa" stroke-width="2" marker-end="url(#arrowhead)" class="flow-line"/>

                    <!-- Arrow marker -->
                    <defs>
                        <marker id="arrowhead" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
                            <polygon points="0 0, 10 3, 0 6" fill="#00d4aa"/>
                        </marker>
                    </defs>
                </svg>
                <div class="architecture-caption">
                    <p><strong>Shamir Secret Sharing (2 of 3 threshold)</strong></p>
                    <ul>
                        <li>Client splits secret into 3 shares</li>
                        <li>Each share sent to independent server</li>
                        <li><strong>No single server has complete secret</strong></li>
                        <li>Any 2 shares can reconstruct the original</li>
                        <li>Loss of 1 server = no data loss</li>
                    </ul>
                </div>
            </div>

            <!-- Purpose 2: Fault Tolerance -->
            <div class="architecture-purpose" data-aos="fade-up" data-aos-delay="200">
                <h3><span class="purpose-number">2</span> Fault Tolerance & High Availability</h3>
                <p>Instances can accept jobs on behalf of each other. When a down instance recovers, it processes queued jobs without client resubmission.</p>
            </div>

            <div class="fault-tolerance-diagram" data-aos="zoom-in" data-aos-duration="1000">
                <svg viewBox="0 0 900 350" class="arch-svg">
                    <!-- Background -->
                    <rect width="900" height="350" fill="#0a0a0f"/>

                    <!-- Grid pattern -->
                    <rect width="900" height="350" fill="url(#smallGrid)"/>

                    <!-- Title -->
                    <text x="450" y="30" text-anchor="middle" fill="#888888" font-family="Inter" font-size="12">PURPOSE 2: FAULT TOLERANCE</text>

                    <!-- Status label -->
                    <text x="450" y="55" text-anchor="middle" fill="#22c55e" font-family="Inter" font-size="11">Server 2 is DOWN, other servers accept its jobs</text>

                    <!-- Client -->
                    <g class="node client" transform="translate(50, 120)">
                        <rect x="0" y="0" width="100" height="90" rx="8" fill="#1a1a2e" stroke="#00d4aa" stroke-width="2"/>
                        <text x="50" y="40" text-anchor="middle" fill="#ffffff" font-family="Inter" font-size="12" font-weight="600">Client</text>
                        <text x="50" y="58" text-anchor="middle" fill="#888888" font-family="Inter" font-size="10">App</text>
                        <text x="50" y="75" text-anchor="middle" fill="#00d4aa" font-family="Inter" font-size="9">Submits job</text>
                    </g>

                    <!-- Arrow to Server 1 -->
                    <g>
                        <path d="M 150 150 L 200 100" stroke="#00d4aa" stroke-width="2" marker-end="url(#arrowGreen2)" class="flow-line"/>
                        <text x="165" y="115" fill="#00d4aa" font-family="Inter" font-size="9">Job for S2</text>
                    </g>

                    <!-- Server 1 (Online) -->
                    <g class="node server" transform="translate(210, 50)">
                        <rect x="0" y="0" width="110" height="80" rx="8" fill="#1a1a2e" stroke="#22c55e" stroke-width="2"/>
                        <text x="55" y="30" text-anchor="middle" fill="#ffffff" font-family="Inter" font-size="12" font-weight="600">Server 1</text>
                        <text x="55" y="48" text-anchor="middle" fill="#22c55e" font-family="Inter" font-size="9">● ONLINE</text>
                        <text x="55" y="65" text-anchor="middle" fill="#6366f1" font-family="Inter" font-size="9">Share 0</text>
                    </g>

                    <!-- Queue box -->
                    <g transform="translate(210, 145)">
                        <rect x="0" y="0" width="110" height="40" rx="6" fill="#6366f1" opacity="0.15" stroke="#6366f1" stroke-width="1" stroke-dasharray="3,3"/>
                        <text x="55" y="18" text-anchor="middle" fill="#6366f1" font-family="Inter" font-size="9">Job Queue</text>
                        <text x="55" y="32" text-anchor="middle" fill="#888888" font-family="Inter" font-size="8">[S2 job waiting]</text>
                    </g>

                    <!-- Server 2 (Offline) -->
                    <g class="node server offline" transform="translate(395, 50)">
                        <rect x="0" y="0" width="110" height="80" rx="8" fill="#1a1a2e" stroke="#ef4444" stroke-width="2" stroke-dasharray="6,4"/>
                        <text x="55" y="30" text-anchor="middle" fill="#ffffff" font-family="Inter" font-size="12" font-weight="600">Server 2</text>
                        <text x="55" y="48" text-anchor="middle" fill="#ef4444" font-family="Inter" font-size="9">● OFFLINE</text>
                        <text x="55" y="65" text-anchor="middle" fill="#8b5cf6" font-family="Inter" font-size="9">Share 1</text>
                    </g>

                    <!-- Server 2 offline indicator -->
                    <g transform="translate(395, 145)">
                        <rect x="0" y="0" width="110" height="40" rx="6" fill="rgba(239, 68, 68, 0.1)"/>
                        <text x="55" y="18" text-anchor="middle" fill="#ef4444" font-family="Inter" font-size="9">Not Accepting Jobs</text>
                        <text x="55" y="32" text-anchor="middle" fill="#888888" font-family="Inter" font-size="8">Will process on recovery</text>
                    </g>

                    <!-- Server 3 (Online) -->
                    <g class="node server" transform="translate(580, 50)">
                        <rect x="0" y="0" width="110" height="80" rx="8" fill="#1a1a2e" stroke="#22c55e" stroke-width="2"/>
                        <text x="55" y="30" text-anchor="middle" fill="#ffffff" font-family="Inter" font-size="12" font-weight="600">Server 3</text>
                        <text x="55" y="48" text-anchor="middle" fill="#22c55e" font-family="Inter" font-size="9">● ONLINE</text>
                        <text x="55" y="65" text-anchor="middle" fill="#ec4899" font-family="Inter" font-size="9">Share 2</text>
                    </g>

                    <!-- Queue box -->
                    <g transform="translate(580, 145)">
                        <rect x="0" y="0" width="110" height="40" rx="6" fill="#ec4899" opacity="0.15" stroke="#ec4899" stroke-width="1" stroke-dasharray="3,3"/>
                        <text x="55" y="18" text-anchor="middle" fill="#ec4899" font-family="Inter" font-size="9">Job Queue</text>
                        <text x="55" y="32" text-anchor="middle" fill="#888888" font-family="Inter" font-size="8">[S2 job waiting]</text>
                    </g>

                    <!-- Recovery section -->
                    <g transform="translate(740, 60)">
                        <rect x="0" y="0" width="140" height="110" rx="8" fill="rgba(34, 197, 94, 0.05)" stroke="#22c55e" stroke-width="1" stroke-dasharray="4,4"/>
                        <text x="70" y="25" text-anchor="middle" fill="#22c55e" font-family="Inter" font-size="10" font-weight="600">When S2 Recovers:</text>
                        <text x="70" y="50" text-anchor="middle" fill="#888888" font-family="Inter" font-size="8">1. S2 comes back online</text>
                        <text x="70" y="68" text-anchor="middle" fill="#888888" font-family="Inter" font-size="8">2. Reads queued jobs</text>
                        <text x="70" y="86" text-anchor="middle" fill="#888888" font-family="Inter" font-size="8">3. Processes normally</text>
                        <text x="70" y="104" text-anchor="middle" fill="#00d4aa" font-family="Inter" font-size="8">No client retry needed!</text>
                    </g>

                    <!-- Arrow marker definition -->
                    <defs>
                        <marker id="arrowGreen2" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
                            <polygon points="0 0, 10 3, 0 6" fill="#00d4aa"/>
                        </marker>
                    </defs>
                </svg>
                <div class="architecture-caption">
                    <p><strong>Fault Tolerance & High Availability</strong></p>
                    <ul>
                        <li><strong>Instances monitor each other's health</strong> via RethinkDB real-time sync</li>
                        <li><strong>Jobs are queued</strong> for any instance that is down</li>
                        <li><strong>No client retry needed</strong>, queued jobs process automatically on recovery</li>
                        <li><strong>24 7 availability</strong>, system functions with any 2 of 3 instances</li>
                    </ul>
                </div>
            </div>

            <!-- Combined Benefits -->
            <div class="combined-benefits" data-aos="fade-up" data-aos-delay="300">
                <h3>Combined: Security + Reliability</h3>
                <div class="benefits-grid">
                    <div class="benefit-card">
                        <div class="benefit-icon">🔐</div>
                        <h4>No Single Point of Compromise</h4>
                        <p>Breaching one server reveals nothing useful, only a partial share</p>
                    </div>
                    <div class="benefit-card">
                        <div class="benefit-icon">⚡</div>
                        <h4>No Single Point of Failure</h4>
                        <p>Losing one server does not stop the system, other instances continue operating</p>
                    </div>
                    <div class="benefit-card">
                        <div class="benefit-icon">🔄</div>
                        <h4>Zero Downtime Recovery</h4>
                        <p>Down instances catch up automatically, clients never need to resubmit</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Comparison Table -->
    <section class="comparison">
        <div class="container">
            <div class="section-header" data-aos="fade-up">
                <h2>Traditional Approach vs NI6</h2>
                <p>Why eliminating third party exposure matters</p>
            </div>
            <div class="comparison-table" data-aos="fade-up" data-aos-delay="200">
                <div class="table-header">
                    <div class="col">Security Risk</div>
                    <div class="col">Traditional KYC & Custody</div>
                    <div class="col highlight">NI6 Solution</div>
                </div>
                <div class="table-row">
                    <div class="col">PII Storage</div>
                    <div class="col">KYC providers store all documents and extracted data on their servers</div>
                    <div class="col highlight">Extracted data encrypted to users device, NI6 never stores PII</div>
                </div>
                <div class="table-row">
                    <div class="col">Custodial Risk</div>
                    <div class="col">Keys held by Fireblocks, Coinbase Custody, or similar third parties</div>
                    <div class="col highlight">2 of 3 Shamir sharing, no single point of failure</div>
                </div>
                <div class="table-row">
                    <div class="col">Policy Vulnerabilities</div>
                    <div class="col">Misconfigured platform-custodian policies caused ByBit/WazirX losses</div>
                    <div class="col highlight">Algorithmic decisions, no human override paths to exploit</div>
                </div>
                <div class="table-row">
                    <div class="col">Sub-Processing Chain</div>
                    <div class="col">Your data flows through cloud providers, ML APIs, support contractors</div>
                    <div class="col highlight">Deterministic algorithms, no human eyes on PII, ever</div>
                </div>
                <div class="table-row">
                    <div class="col">Breach Impact</div>
                    <div class="col">One KYC provider breach leaks millions of identities permanently</div>
                    <div class="col highlight">Even if NI6 is breached, only encrypted blobs useless to attackers</div>
                </div>
                <div class="table-row">
                    <div class="col">Your Service Backend Liability</div>
                    <div class="col">Your service backend stores user PII, GDPR or HIPAA compliance burden</div>
                    <div class="col highlight">Your service backend receives only approve or reject, zero PII liability</div>
                </div>
            </div>
        </div>
    </section>

    <!-- Technology Stack -->
    <section class="technology" id="technology">
        <div class="container">
