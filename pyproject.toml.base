[tool.poetry]
name = "im-osint-refactor"
version = "0.1.0"
description = ""
authors = ["Mano Thanabalan <mano@immin.io>"]
packages = [
    { include = "app" }
]

[tool.poetry.dependencies]
python = ">=3.10,<3.13"  # Python 3.11 recommended for Docker builds (better PhotoHolmes compatibility)
fastapi = "^0.116.0"
uvicorn = {extras = ["standard"], version = "^0.35.0"}
aiohttp = "^3.10.0"
mysql-connector-python = "^9.3.0"
python-dotenv = "^1.1.1"
pypdf = "^5.7.0"
ddgs = "^9.0.2"

# PhotoHolmes integrated dependencies (previously external photoholmes package)
numpy = ">=1.26.0,<2.0.0"  # TensorFlow 2.17+ requires numpy>=1.26.0, strictly <2.0 for compatibility
matplotlib = "^3.7.0"
scikit-image = "^0.25.2"
mpmath = "^1.3.0"
# jpegio replaced with modern Pillow/OpenCV implementation
torch-kmeans = "^0.2.0"
# OpenCV for image processing (headless for Docker/server environments)
opencv-python-headless = "^4.11.0"
# MediaPipe for hand gesture detection (video selfie OTP)
mediapipe = "^0.10.0"
# ONNX Runtime (platform-compatible)
onnxruntime = "^1.16.0"
onnx = "<1.19.0"   # Pin to version before float4_e2m1fn requirement (conflicts with TensorFlow)
pillow = "^11.3.0"
tensorflow = "2.17.1"
tf-keras = "2.17.0"    # Latest compatible version for TensorFlow 2.20.0
keras = "<3.12.0"   # Pin to version before float4_e2m1fn requirement
# DeepFace forked into app/deepface/ - no longer using pip package
# deepface = "^0.0.96"
gdown = "^3.10.1"
mtcnn = "^0.1.0"
retina-face = "^0.0.14"
tqdm = "^4.30.0"
pandas = "^2.0.0"
requests = "^2.27.1"
pymupdf = "^1.24.0"
python-dateutil = "^2.9.0"
rapidfuzz = "^3.0.0"
boto3 = "^1.35.0"
botocore = "^1.35.0"
pydantic-settings = "^2.0.0"
# imdlbenco = "^0.1.42"  # Removed: Custom IMDLBenCo CAT-Net implementation used instead
transformers = "^4.57.3"
scikit-learn = "^1.5.0"  # Required by PhotoHolmes EXIF As Language method
# PhotoHolmes now integrated in app/photoholmes - no separate dependency needed

# Additional essential dependencies (required for all build types)
ecdsa = "^0.19.1"
pycryptodome = "^3.23.0"
cryptography = "^41.0.0"
pynacl = "^1.5.0"
lightphe = "^0.0.15"
click = "^8.0.0"
wget = "^3.2.0"

# Rate limiting for API endpoints
slowapi = "^0.1.9"

# FFmpeg for frame-accurate video extraction
ffmpeg-python = "^0.2.0"

# NLP models for enhanced negative news detection
nltk = "^3.8.1"
spacy = "^3.7.2"
gliner2 = "^1.2.4"  # Named Entity Recognition for document extraction
trafilatura = "^1.6.0"  # Modern article extraction with better anti-bot handling

# City/State lookup for address parsing
countrystatecity-countries = "^1.0.0"
# DocTR for OCR text extraction (passports, documents, geometry-aware analysis)
python-doctr = "^1.0.0"

[tool.poetry.group.gpu.dependencies]
psutil = "^5.9.0"

[tool.poetry.group.dev.dependencies]
pytest = "^7.0.0"
pytest-asyncio = "^0.21.0"
black = "^23.0.0"
ruff = "^0.1.0"
mypy = "^1.0.0"

[tool.pyright]
useLibraryCodeForTypes = true
exclude = [".cache","__pycache__",".venv"]

[tool.ruff]
select = ["E", "W", "B", "C", "F", "I", "N", "Q", "R", "S", "T", "UP", "Y"]
ignore = ["W291", "W292", "W293"]
line-length = 120

[tool.poetry.scripts]
app = "app.main:main"

[build-system]
requires = ["poetry-core>=2.0.0,<3.0.0"]
build-backend = "poetry.core.masonry.api"
