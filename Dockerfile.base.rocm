# Base image for IM-OSINT ROCm builds
# Contains: system deps, Python 3.12, Poetry, dependencies, PyTorch ROCm, weights
# Build: docker build -f Dockerfile.base.rocm -t 10.0.0.14:5000/im-osint-base-rocm:latest .
# Push: docker push 10.0.0.14:5000/im-osint-base-rocm:latest

FROM rocm/tensorflow:rocm6.3.3-py3.12-tf2.17-runtime

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=off \
    PIP_DISABLE_PIP_VERSION_CHECK=on \
    PIP_DEFAULT_TIMEOUT=300 \
    PIP_RETRIES=5 \
    POETRY_NO_INTERACTION=1 \
    POETRY_VIRTUALENVS_CREATE=false \
    POETRY_CACHE_DIR=/tmp/poetry_cache \
    TF_CPP_MIN_LOG_LEVEL=2 \
    TF_USE_LEGACY_KERAS=1 \
    ROCM_ARCH=gfx906 \
    ROCM_PATH=/opt/rocm \
    LD_LIBRARY_PATH=$LD_LIBRARY_PATH:/opt/rocm/lib:/opt/rocm/lib64 \
    PATH=$PATH:/opt/rocm/bin:/opt/rocm/profiler/bin:/opt/rocm/opencl/bin \
    PYTHONPATH=$PYTHONPATH:/usr/local/lib/python3.12/site-packages \
    HIP_VISIBLE_DEVICES=0 \
    ROC_ENABLE_PRE_VEGA=1 \
    MIOPEN_USER_DB_PATH=/root/.config/miopen \
    MIOPEN_CACHE_DIR=/root/.cache/miopen \
    MIOPEN_FIND_MODE=3 \
    PYTORCH_HIP_ALLOC_CONF=expandable_segments:True \
    DOCTR_CACHE_DIR=/app/app/models/doctr \
    DEEPFACE_HOME=/app/app/deepface

# Install necessary build tools and app dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake git libsm6 libxext6 libglib2.0-0 ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Install poetry (use --break-system-packages as this is Ubuntu 24.04 base)
RUN pip install --upgrade pip setuptools wheel --break-system-packages && \
    pip install poetry --break-system-packages

# Set working directory
WORKDIR /app

# Copy dependency files only (not full source)
COPY pyproject.toml.rocm poetry.lock* ./

# Install dependencies with Poetry
RUN cp pyproject.toml.rocm pyproject.toml && \
    poetry lock && \
    poetry install --no-root --no-interaction --no-ansi && \
    rm -rf /tmp/poetry_cache && \
    echo "Poetry dependencies installed"

# Copy and install PyTorch from local ROCm wheels
COPY wheels/rocm/ /tmp/wheels/
RUN pip3 install /tmp/wheels/* && \
    rm -rf /tmp/wheels && \
    echo "PyTorch installed with ROCm support from local wheels"

# Copy pre-downloaded weights (5.1 GB - rarely change)
COPY app/deepface/.deepface/weights/ /app/app/deepface/.deepface/weights/
COPY app/photoholmes/weights/ /app/app/photoholmes/weights/
COPY app/spacy_models/ /app/app/spacy_models/
COPY app/models/nltk/ /app/app/models/nltk/
COPY app/models/finbert/ /app/app/models/finbert/
COPY app/models/gliner2/ /app/app/models/gliner2/
COPY app/models/mediapipe/ /app/app/models/mediapipe/
COPY app/models/doctr/ /app/app/models/doctr/

# Create runtime directories and MIOpen cache
RUN mkdir -p /app/logs /app/temp /var/run/mysqld /root/.config/miopen /root/.cache/miopen
