# Large files and datasets (excluding PhotoHolmes weights)
*.h5
*.hdf5
*.pkl
*.pickle
*.joblib
*.model
*.bin
*.ckpt

# PhotoHolmes weights should be included, not ignored
# All .pth files in integrated weights directory are needed for PhotoHolmes
!app/photoholmes/weights/
!app/photoholmes/weights/*.pth
!app/photoholmes/weights/**/*.pth

# DeepFace weights should be included to avoid runtime downloads
!app/deepface_weights/
!app/deepface_weights/*.h5
!app/deepface_weights/*.pth

# FinBERT weights should be included to avoid runtime downloads
!app/finbert_weights/

app/doctr_weights
app/gliner2_weights

