# Explicitly include model weights (override exclusions above)
!app/deepface/.deepface/weights/**/*
!app/photoholmes/weights/**/*
!app/models/**/*

# Model weights locations:
# - app/deepface/.deepface/weights/ - DeepFace face detection models
# - app/models/nltk/ - NLTK data
# - app/models/finbert/ - FinBERT financial sentiment model
# - app/photoholmes/weights/ - PhotoHolmes forgery detection models
# - app/spacy_models/ - spaCy NLP models
# All copied separately in base Docker images to reduce layer size

